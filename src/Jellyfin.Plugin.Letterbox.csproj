<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Letterbox</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Letterbox</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Compiled against the exact Jellyfin 12.2 server assemblies (copied from the installed Jellyfin.app).
       Private=false: they are provided by the server at runtime and must not be shipped with the plugin. -->
  <ItemGroup>
    <Reference Include="MediaBrowser.Controller"><HintPath>../lib/MediaBrowser.Controller.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Common"><HintPath>../lib/MediaBrowser.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Model"><HintPath>../lib/MediaBrowser.Model.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jellyfin.Data"><HintPath>../lib/Jellyfin.Data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jellyfin.Database.Implementations"><HintPath>../lib/Jellyfin.Database.Implementations.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jellyfin.Extensions"><HintPath>../lib/Jellyfin.Extensions.dll</HintPath><Private>false</Private></Reference>
    <!-- Microsoft.Extensions.* (logging, DI) come with the ASP.NET Core shared framework the server runs on -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
